# ============================================
# Шаблон переменных окружения для проекта Autéllo Barskiy
# ============================================
# Скопируй в .env и заполни реальными значениями.
# .env НЕ коммитится (см. .gitignore).
# ============================================

# --- PostgreSQL ---
# Для локальной разработки: POSTGRES_HOST=autello-db (имя контейнера из docker-compose.yml)
# Для деплоя на сервер: POSTGRES_HOST=infra-postgres
POSTGRES_HOST=autello-db
POSTGRES_PORT=5432
POSTGRES_USER=autello
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=autello_db

# --- JWT для админ-авторизации ---
# Сгенерировать уникальный ключ: openssl rand -hex 32
# Утечка ключа = возможность подписывать токены от имени админа — поэтому
# в проде и локально ключи РАЗНЫЕ, и ни один не коммитится.
SECRET_KEY=CHANGE_ME
