# ============================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ ДЛЯ infra
# ============================================
# Скопируй этот файл в .env и заполни реальными значениями.
# .env НИКОГДА не коммитится в git (см. .gitignore).
# ============================================

# --- PostgreSQL (суперпользователь) ---
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

# --- pgAdmin (веб-админка Postgres) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Docker Registry (учётная запись для push/pull) ---
# Пароль устанавливается через registry/create-user.sh, здесь только для справки
REGISTRY_USER=admin
REGISTRY_PASSWORD=CHANGE_ME_STRONG_PASSWORD
